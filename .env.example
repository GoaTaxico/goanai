# Server-only. Never put this in client code or commit a real value.
XKIRO_API_KEY=

# Optional server model override. Visitors never see this.
# BHARAT_MODEL=

# Public site URL for the canonical link and Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Guest cap. Resets at midnight IST.
# DAILY_MESSAGE_LIMIT=50
# RATE_LIMIT_SALT=change-me
